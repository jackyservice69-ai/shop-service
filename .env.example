PORT=3002
APP_ORIGIN=http://127.0.0.1:5174
DATABASE_PATH=./data/hiewly.sqlite
# Server-only OAuth client file; never use VITE_ for a client secret.
GOOGLE_CREDENTIALS_FILE=./.secrets/google-oauth.json
# Cloud alternative: set BOTH server-only values; takes precedence over the file.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to APP_ORIGIN + /api/auth/google/callback; register this exact URI in Google Cloud.
GOOGLE_REDIRECT_URI=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SETTINGS_ENCRYPTION_KEY=
EASYSLIP_API_KEY=
ADMIN_EMAIL=admin@hiewly.local
# Required for bootstrap; minimum 12 characters. Never commit real values.
ADMIN_PASSWORD=
# In production: HTTPS origin, NODE_ENV=production, TRUST_PROXY=1 only behind one trusted proxy
TRUST_PROXY=0
# Cloud migration: start with node scripts/cloud-start.mjs and set both to 1.
# Remove CLOUD_MIGRATION_PENDING only after restoring and verifying the database.
REQUIRE_EXISTING_DATABASE=0
CLOUD_MIGRATION_PENDING=0

LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# Optional server-only fallback. Configure Login Channel ID and switches in owner settings.
# Distinct from the Messaging API Channel Secret above.
LINE_LOGIN_CHANNEL_SECRET=
OPENAI_API_KEY=
BANK_CODE=
BANK_NUMBER=
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NAME_EN=
